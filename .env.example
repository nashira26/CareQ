# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, set the same variables in the service's Environment tab.

# ---------- Server ----------
# "production" serves the built frontend (npm run build -> dist/) and turns on secure cookies.
# Leave unset locally (development uses Vite).
# NODE_ENV=production
# Port to listen on (Render sets this automatically).
PORT=3000

# ---------- Demo data ----------
# mongo (default): data in MongoDB Atlas, shared across devices.
# local: each browser keeps its own data in localStorage (no database needed).
DATA_MODE=mongo
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep it secret.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name: careq_dev locally, careq_demo on Render. (npm test uses a temporary careq_test.)
MONGODB_DB=careq_dev

# ---------- Reset ----------
# POST /api/reset re-seeds the database only when ALLOW_RESET=true AND the X-Reset-Token header matches RESET_TOKEN.
ALLOW_RESET=false
# Long random secret, e.g. from: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RESET_TOKEN=change-me-to-a-long-random-secret
# Optional: default target for "npm run reset" (otherwise http://localhost:$PORT; or pass a URL as an argument).
# RESET_URL=https://your-app.onrender.com

# ---------- Gemini AI (server only; never sent to the browser) ----------
GEMINI_API_KEY=your_key_here
# Optional: model to use.
GEMINI_MODEL=gemini-3.5-flash
# Optional: milliseconds to wait for Gemini before using the backup model. Default 15000.
# GEMINI_TIMEOUT_MS=15000
# Optional: backup model tried once if the main model times out or is overloaded (429/503).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: embedding model for npm run build:index (768 dimensions). Changing it means rebuilding the index.
# GEMINI_EMBED_MODEL=gemini-embedding-2
# GEMINI_FALLBACK_TIMEOUT_MS=10000
