# Copy this file to .env and fill in your own values. Never commit .env.

# Required for the Gemini AI tools (server only; never sent to the browser).
GEMINI_API_KEY=your_key_here

# Optional: Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash

# Optional: milliseconds to wait for Gemini before using the basic (non-AI) fallback. Default 15000.
# GEMINI_TIMEOUT_MS=15000
